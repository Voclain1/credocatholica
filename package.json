{
  "name": "credocatholica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "migration:wp": "tsx scripts/wordpress-migration/run.ts --dry-run",
    "migration:wp:fixtures": "tsx scripts/wordpress-migration/run.ts --dry-run --fixtures",
    "migration:wp:apply": "tsx scripts/wordpress-migration/run.ts --apply",
    "migration:wp:test": "tsx --test scripts/wordpress-migration/test/migration.test.ts",
    "test:liturgy": "tsx --test src/lib/liturgy/test/liturgy.test.ts",
    "liturgy:ingest": "tsx scripts/liturgical-ingestion/run.ts",
    "liturgy:ingest:fixtures": "tsx scripts/liturgical-ingestion/run.ts --fixtures",
    "liturgy:ingest:test": "tsx --test scripts/liturgical-ingestion/test/ingestion.test.ts",
    "liturgy:ingest:apply": "tsx scripts/liturgical-ingestion/run.ts --apply",
    "m1:ingest:test": "tsx --test scripts/m1-ingestion/test/m1-ingestion.test.ts",
    "platform:test": "tsx --test scripts/m1-ingestion/test/full-platform.test.ts",
    "content:audit": "tsx scripts/content-audit/run.ts",
    "content:repair-metadata": "tsx scripts/content-audit/repair-metadata.ts",
    "content:test": "tsx --test scripts/content-audit/test/content-integrity.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.3.3",
    "@prisma/config": "^7.10.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.5.1",
    "prisma": "^7.10.0",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
