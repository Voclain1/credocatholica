{
  "name": "credocatholica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "migration:wp": "tsx scripts/wordpress-migration/run.ts --dry-run",
    "migration:wp:fixtures": "tsx scripts/wordpress-migration/run.ts --dry-run --fixtures",
    "migration:wp:apply": "tsx scripts/wordpress-migration/run.ts --apply",
    "migration:wp:test": "tsx --test scripts/wordpress-migration/test/migration.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "next": "16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.10.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.5.1",
    "prisma": "^7.10.0",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
